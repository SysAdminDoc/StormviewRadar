{
  "name": "stormview-radar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cesium": "node scripts/build-cesium-engine.mjs",
    "build:level2": "node scripts/build-level2-worker.mjs",
    "test": "npm run test:static && npm run test:unit && node scripts/test-browsers.mjs",
    "test:static": "npm run build:cesium && npm run build:level2 && node scripts/check-syntax.mjs && node scripts/check-version.mjs && node scripts/check-vendor.mjs && node scripts/check-static.mjs",
    "test:unit": "node --test tests/*.test.js",
    "release:check": "npm test && npm audit --audit-level=moderate",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "cesium": "1.145.0",
    "leaflet": "1.9.4",
    "nexrad-level-2-data": "2.4.3",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.1"
  }
}
